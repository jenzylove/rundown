# The same image as Dockerfile, for building behind the cloud session's HTTPS-only proxy (scripts/deploy.sh picks it
# up when PROXY_CA is set). The proxy's CA is mounted per step and never lands in the image.
# Keep in step with Dockerfile: only the npm, apt and pip lines differ.

FROM node:22-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN --mount=type=secret,id=proxyca,target=/tmp/ca.crt,mode=0444 NODE_EXTRA_CA_CERTS=/tmp/ca.crt npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
# the Speech SDK needs OpenSSL, CA certificates and ALSA's shared library, even with no sound card
RUN --mount=type=secret,id=proxyca,target=/tmp/ca.crt,mode=0444 sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
 && apt-get -o Acquire::https::CAInfo=/tmp/ca.crt update \
 && apt-get -o Acquire::https::CAInfo=/tmp/ca.crt install -y --no-install-recommends ca-certificates libssl3 libasound2 \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml ./
COPY rundown/ rundown/
COPY schema/ schema/
COPY docs/evals/ docs/evals/
RUN --mount=type=secret,id=proxyca,target=/tmp/ca.crt,mode=0444 PIP_CERT=/tmp/ca.crt pip install --no-cache-dir ".[api,agents,azure]"
COPY --from=web /web/dist web/dist
ENV PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["uvicorn", "rundown.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
